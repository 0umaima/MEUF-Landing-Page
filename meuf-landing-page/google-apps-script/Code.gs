// In Google Sheets > Extensions > Apps Script, paste this entire file.
// Set ORDER_SECRET and SPREADSHEET_ID in Project Settings > Script properties.
var TAB='Commandes';
var HEADERS=['Request ID','Order ID','Date','Nom','Téléphone','Ville','Adresse','Produit','Couleur','Taille','Quantité','Prix unitaire (MAD)','Sous-total (MAD)','Livraison (MAD)','Total (MAD)','Statut','Consentement pub','utm_source','utm_medium','utm_campaign','utm_content','utm_term','campaign_id','adset_id','ad_id'];
function output(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
function getSheet(){var id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Missing spreadsheet ID');var ss=SpreadsheetApp.openById(id);var sheet=ss.getSheetByName(TAB);if(!sheet)sheet=ss.insertSheet(TAB);if(sheet.getLastRow()===0){sheet.appendRow(HEADERS);sheet.setFrozenRows(1);sheet.getRange(1,1,1,HEADERS.length).setFontWeight('bold');sheet.getRange('E:E').setNumberFormat('@');}return sheet;}
// Run once manually to initialize and authorize spreadsheet access.
function setup(){getSheet();}
// Prevent spreadsheet formula injection and preserve phone / ID formatting.
function safe(v){var s=String(v==null?'':v);return /^[\s]*[=+\-@]/.test(s)||/^[\t\r\n]/.test(s)?"'"+s:s;}
function doPost(e){var lock=null;try{var d=JSON.parse(e.postData.contents);var secret=PropertiesService.getScriptProperties().getProperty('ORDER_SECRET');if(!secret||d.secret!==secret)return output({success:false,error:'Unauthorized'});if(!/^[0-9a-f-]{36}$/i.test(d.requestId)||!d.name||!d.phone||!d.city||!d.address||!Number.isInteger(d.quantity)||d.quantity<1||d.quantity>10||!Number.isFinite(d.total))return output({success:false,error:'Invalid order'});lock=LockService.getScriptLock();lock.waitLock(20000);var sheet=getSheet();if(sheet.getLastRow()>1){var found=sheet.getRange(2,1,sheet.getLastRow()-1,1).createTextFinder(d.requestId).matchEntireCell(true).findNext();if(found)return output({success:true,orderId:String(sheet.getRange(found.getRow(),2).getValue())});}var id='MEUF-'+Utilities.getUuid();var a=d.attribution||{};sheet.appendRow([safe(d.requestId),id,new Date(),safe(d.name),safe(d.phone),safe(d.city),safe(d.address),safe(d.productName),safe(d.color),safe(d.size),d.quantity,d.unitPrice,d.subtotal,d.shipping,d.total,'Nouveau',d.consent===true?'Oui':'Non',safe(a.utm_source),safe(a.utm_medium),safe(a.utm_campaign),safe(a.utm_content),safe(a.utm_term),safe(a.campaign_id),safe(a.adset_id),safe(a.ad_id)]);SpreadsheetApp.flush();return output({success:true,orderId:id});}catch(err){return output({success:false,error:'Order service unavailable'});}finally{if(lock&&lock.hasLock())lock.releaseLock();}}
